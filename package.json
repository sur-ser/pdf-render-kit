{
  "name": "pdf-render-kit",
  "version": "0.1.0",
  "description": "Library for rendering PDF from URL/HTML with local queue, retries, and post-optimization.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.MD",
    "LICENSE"
  ],
  "keywords": ["pdf", "playwright", "html-to-pdf", "url-to-pdf", "ghostscript", "qpdf", "mupdf"],
  "author": "Your Name <you@example.com>",
  "license": "MIT",
  "homepage": "https://github.com/sur-ser/pdf-render-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sur-ser/pdf-render-kit.git"
  },
  "bugs": {
    "url": "https://github.com/sur-ser/pdf-render-kit/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}